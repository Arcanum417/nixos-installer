#!/usr/bin/env expect
#
# Drives a full install-me.sh run over the guest's serial console.
#
#   install.expect LOGFILE PORT NDISKS FIRMWARE
#
# Exits 0 only when the installer prints its own completion line. Any other
# outcome (a FATAL from lib/common.sh, a shell that never appears, a timeout)
# is a failure with a distinct exit code so the suite can say which stage died.
#
# Pattern choice matters here: lib/common.sh colours its prompts, so
# "Type \033[1mDESTROY\033[0m to continue" cannot be matched on the word
# DESTROY. Every pattern below is a run of plain text with no escape sequence
# inside it.

set logfile  [lindex $argv 0]
set port     [lindex $argv 1]
set ndisks   [lindex $argv 2]
set firmware [lindex $argv 3]

# The transcript is written here rather than by redirecting stdout: expect
# buffers a redirected stdout, which makes a multi-hour run impossible to watch
# and truncates the evidence if it is killed. log_file writes as it goes and
# captures send_user output too, so the "FAILED:" line lands in the log.
log_file -a $logfile
set send_slow {1 .05}

# TCG emulation is slow and nixos-install downloads a closure, so these are
# deliberately generous. A hung guest costs one timeout, not a wrong answer.
set boot_timeout    30
set prompt_timeout  600
set install_timeout 14400

# A booting kernel produces far more output than expect's default 2000-byte
# match buffer holds. When it overflows expect discards the oldest half, and
# a marker that arrived in that half is never matched -- the transcript shows
# the text arriving while expect sits waiting for it.
match_max 200000

proc bail {code msg} {
    # send_log as well as send_user: log_file records only the spawned
    # process's I/O, so a send_user-only line never reaches the transcript
    # that the suite greps for "FAILED:".
    send_user "\n\[install.expect\] FAILED: $msg\n"
    send_log  "\n\[install.expect\] FAILED: $msg\n"
    exit $code
}

# UTM drops the serial TCP client when the guest reinitialises the UART, which
# GRUB does on its way to the kernel. That is one expected disconnect per boot,
# not an error, so every wait below reconnects rather than failing.
#
# `spawn` must not live inside a proc that does not declare spawn_id global:
# it would set a local one and the caller would be left with no connection.
set drops 0
set nudges 0
set connected 0
proc serial_connect {} {
    global spawn_id port connected
    # Only close a connection that exists. `close` with nothing spawned
    # targets expect's own stdout and silently kills this script's output.
    if {$connected} { catch {close}; catch {wait} }
    sleep 2
    # How to reach the guest's serial console is backend-specific, so the
    # backend supplies the command and this driver stays ignorant of it.
    # UTM exposes a listening TCP socket, hence the nc default. Proxmox
    # publishes a unix socket on the node instead, so its backend sets
    # VM_SERIAL_CMD to an ssh+socat invocation. `-T` and a bare `socat -`
    # matter there: a remote pty would translate \n to \r\n and corrupt the
    # transcript.
    # ::env, fully qualified. This sits inside a proc, and a proc does not see
    # the global `env` array unless it says so -- an unqualified env(...) here
    # silently referred to a nonexistent local and every run fell back to nc,
    # which on a Proxmox run meant connecting to whatever happened to be on
    # that TCP port instead of to the guest. Same class of trap as spawn_id.
    if {[info exists ::env(VM_SERIAL_CMD)] && $::env(VM_SERIAL_CMD) ne ""} {
        # Retry, and say so when it fails. The Proxmox console is a unix socket
        # that QEMU creates at VM start and removes at stop, so a connect
        # attempt during a reboot legitimately fails -- and a spawn that fails
        # leaves spawn_id pointing at the previous, now-closed connection,
        # which surfaces much later as an inscrutable "spawn id ... not open".
        set ok 0
        for {set try 0} {$try < 30} {incr try} {
            # spawn the path directly -- no eval, no split. `eval spawn
            # [split $cmd]` left spawn_id holding the command string with its
            # first eight characters lopped off ("ssh -T -", "/var/fol"),
            # which surfaced later as "spawn id <mangled> not open". The
            # backend hands over a single executable path precisely so this
            # can be one word.
            if {![catch {spawn $::env(VM_SERIAL_CMD)} err]} { set ok 1; break }
            send_log "\n\[serial\] spawn failed (try $try): $err\n"
            sleep 2
        }
        if {!$ok} { bail 26 "could not attach to the guest console: $err" }
    } else {
        spawn nc 127.0.0.1 $port
    }
    set connected 1
}
# Sync on the shell prompt rather than on an echoed marker. Marker text was
# demonstrably read by expect -- it shows up in the transcript -- but never
# matched, while this prompt pattern matches reliably.
proc wait_prompt {code msg} {
    global spawn_id
    expect {
        -re {root@nixos:[^\r\n]*\]#} { }
        eof     { reconnect_or_bail; send -s "\r"; exp_continue }
        timeout { bail $code $msg }
    }
}

proc reconnect_or_bail {} {
    global drops
    incr drops
    if {$drops > 40} { bail 16 "serial connection kept dropping ($drops times)" }
    serial_connect
}

serial_connect

# ---------------------------------------------------------------- get a root shell

# The ISO autologins an unprivileged `nixos` user. Nudge it with a newline in
# case we attached after the prompt was already printed.
set timeout $boot_timeout
send -s "\r"
expect {
    -re {root@nixos:[^\r\n]*\]#} { }
    -re {nixos@nixos:[^\r\n]*\]\$} {
        send -s "sudo -i\r"
        expect {
            -re {root@nixos:[^\r\n]*\]#} { }
            eof     { reconnect_or_bail; send -s "\r"; exp_continue }
            timeout { bail 11 "sudo -i did not produce a root shell" }
        }
    }
    eof     { reconnect_or_bail; send -s "\r"; exp_continue }
    timeout {
        # Nudge and keep waiting. The driver attaches while the guest is still
        # booting, so a single \r is sent before any getty exists and is lost;
        # the ISO then prints its prompt once and will not reprint it
        # unprompted, leaving the guest idle and the driver waiting.
        incr nudges
        if {$nudges > 40} { bail 11 "no login prompt on the serial console (did the ISO boot?)" }
        send -s "\r"
        exp_continue
    }
}

# Quieten the kernel: log spam interleaved with the installer's prompts makes
# every later pattern racy.
send_log "\n\[step\] got root shell, quieting kernel\n"
send -s "dmesg -n 1\r"
wait_prompt 11 "shell did not return a prompt after dmesg"
send_log "\n\[step\] shell responsive\n"

# ---------------------------------------------------------------- stage the repo

# By label, not /dev/sr1: with two CDs attached the numbering is not guaranteed.
set timeout $prompt_timeout
send_log "\n\[step\] mounting NIXINST\n"
send -s "mount -o ro -L NIXINST /mnt\r"
wait_prompt 12 "mounting the NIXINST CD did not return"
send_log "\n\[step\] CD mounted\n"
send -s "mkdir -p /root/repo && cp -r /mnt/. /root/repo/\r"
wait_prompt 12 "copying the repo off the CD did not return"
send -s "umount /mnt; chmod +x /root/repo/*.sh\r"
wait_prompt 12 "chmod did not return"
send_log "\n\[step\] repo staged\n"

# ---------------------------------------------------------------- run it

send_log "\n\[step\] launching install-me.sh\n"

# Answers are fed on stdin rather than typed in response to each prompt.
#
# Matching the prompts was the original design and mostly worked -- the disk
# menu and the DESTROY confirmation were driven that way -- but two prompts
# ("[Y/n]" from confirm, and an echoed shell marker) could not be matched at
# all on this console. expect demonstrably *read* them, they appear in the
# transcript, and neither a glob nor an -re pattern ever fired. Feeding stdin
# sidesteps prompt matching entirely.
#
# The usual objection to this -- a misaligned answer picks the wrong disk to
# wipe -- does not apply here: every disk in the VM is a scratch image. On real
# hardware you would never drive the installer this way.
#
# The sequence below is exact for "UEFI, N disks, no data pool":
#
#   1..N     select_disks toggles each disk           (one line each)
#   d        select_disks done                        (one line)
#   3        ask DATA_CHOICE -> skip the data pool    (one line)
#   DESTROY  confirm_hard                             (one line)
#   y        confirm "Does the pool above look right?"   (read -n 1)
#   <blank>  confirm "Continue to nixos-install?"        (read -n 1 sees the
#            newline left over by the previous answer; empty is not [Nn], so
#            confirm treats it as yes)
set answers ""
for {set i 1} {$i <= $ndisks} {incr i} { append answers "$i\\n" }
append answers "d\\n3\\nDESTROY\\ny\\n"

# The channel copy is left ON, deliberately, even though it is the slowest
# single step of the install.
#
# Skipping it with --no-channel-copy was tried and broke the replace phase:
# replace-boot-disk.sh ends in `nixos-rebuild boot --install-bootloader`, and
# without a channel that dies with
#
#     error: file 'nixpkgs/nixos' was not found in the Nix search path
#
# which is the whole point of the phase. install-me.sh keeps the
# NIXOS_INSTALL_ARGS hook for anyone who wants it, but this suite must not use
# it: a recovery tool that cannot rebuild is not the thing under test.
send -s "cd /root/repo && printf '$answers' | ./install-me.sh; echo INSTALLER-EXIT=\$?\r"

set timeout $install_timeout

# Watched, not driven: the installer is answering itself from stdin now, so
# these patterns only need to notice how it ended.
expect {
    -re {INSTALLER-EXIT=0} {
        send_log "\n\[step\] installer finished cleanly\n"
    }
    -re {INSTALLER-EXIT=[1-9]} {
        bail 14 "install-me.sh exited non-zero"
    }
    -re {FATAL} {
        bail 13 "installer aborted with a FATAL"
    }
    eof     { reconnect_or_bail; send -s "\r"; exp_continue }
    timeout { bail 15 "installer timed out after ${install_timeout}s" }
}

# ---------------------------------------------------------------- power off

# The pools are already exported by the installer; this is just a clean stop so
# the next scenario boots from a quiesced disk.
send -s "poweroff\r"
expect {
    "reboot: Power down" { }
    "Power down"         { }
    eof                  { }
    timeout              { }
}

exit 0
