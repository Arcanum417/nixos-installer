#!/usr/bin/env expect
#
# Boots the installed system and dumps a set of facts about it.
#
#   postboot.expect LOGFILE PORT
#
# Prints one "PROBE:<name>:<value>" line per fact and nothing else that the
# caller cares about; tests/vm-boot.sh parses those and does the asserting, so
# the assertions live in bash with the rest of the suite rather than in Tcl.
#
# Reaching a shell at all is the primary assertion: the guest autologins root
# on ttyS0 only if GRUB found a kernel, the initrd imported the root pool, and
# systemd got as far as a getty.

set logfile [lindex $argv 0]
set port    [lindex $argv 1]

# Written here rather than by redirecting stdout: expect buffers a redirected
# stdout, which hides progress during a long run and truncates the evidence if
# it is killed. log_file also captures send_user, so "FAILED:" reaches the log.
log_file -a $logfile

set boot_timeout 30
set cmd_timeout  300

set send_slow {1 .03}

# A booting kernel produces far more output than expect's default 2000-byte
# match buffer holds. When it overflows expect discards the oldest half, and
# a marker that arrived in that half is never matched -- the transcript shows
# the text arriving while expect sits waiting for it.
match_max 200000

proc bail {code msg} {
    # send_log as well as send_user: log_file records only the spawned
    # process's I/O, so a send_user-only line never reaches the transcript
    # that the suite greps for "FAILED:".
    send_user "\n\[postboot.expect\] FAILED: $msg\n"
    send_log  "\n\[postboot.expect\] FAILED: $msg\n"
    exit $code
}

# One disconnect per boot is expected: UTM drops the serial TCP client when the
# guest reinitialises the UART, which GRUB does on its way to the kernel.
set drops 0
set nudges 0
set connected 0
proc serial_connect {} {
    global spawn_id port connected
    # Only close a connection that exists. `close` with nothing spawned
    # targets expect's own stdout and silently kills this script's output.
    if {$connected} { catch {close}; catch {wait} }
    sleep 2
    # How to reach the guest's serial console is backend-specific, so the
    # backend supplies the command and this driver stays ignorant of it.
    # UTM exposes a listening TCP socket, hence the nc default. Proxmox
    # publishes a unix socket on the node instead, so its backend sets
    # VM_SERIAL_CMD to an ssh+socat invocation. `-T` and a bare `socat -`
    # matter there: a remote pty would translate \n to \r\n and corrupt the
    # transcript.
    # ::env, fully qualified. This sits inside a proc, and a proc does not see
    # the global `env` array unless it says so -- an unqualified env(...) here
    # silently referred to a nonexistent local and every run fell back to nc,
    # which on a Proxmox run meant connecting to whatever happened to be on
    # that TCP port instead of to the guest. Same class of trap as spawn_id.
    if {[info exists ::env(VM_SERIAL_CMD)] && $::env(VM_SERIAL_CMD) ne ""} {
        # Retry, and say so when it fails. The Proxmox console is a unix socket
        # that QEMU creates at VM start and removes at stop, so a connect
        # attempt during a reboot legitimately fails -- and a spawn that fails
        # leaves spawn_id pointing at the previous, now-closed connection,
        # which surfaces much later as an inscrutable "spawn id ... not open".
        set ok 0
        for {set try 0} {$try < 30} {incr try} {
            # spawn the path directly -- no eval, no split. `eval spawn
            # [split $cmd]` left spawn_id holding the command string with its
            # first eight characters lopped off ("ssh -T -", "/var/fol"),
            # which surfaced later as "spawn id <mangled> not open". The
            # backend hands over a single executable path precisely so this
            # can be one word.
            if {![catch {spawn $::env(VM_SERIAL_CMD)} err]} { set ok 1; break }
            send_log "\n\[serial\] spawn failed (try $try): $err\n"
            sleep 2
        }
        if {!$ok} { bail 26 "could not attach to the guest console: $err" }
    } else {
        spawn nc 127.0.0.1 $port
    }
    set connected 1
}
proc reconnect_or_bail {} {
    global drops
    incr drops
    if {$drops > 40} { bail 23 "serial connection kept dropping ($drops times)" }
    serial_connect
}

proc wait_prompt {} {
    global spawn_id
    expect {
        -re {RDY-4b91>|\]133;A|root@[-a-z0-9]+:[^\r\n]*\]#} { }
        eof     { reconnect_or_bail; send -s "\r"; exp_continue }
        timeout { }
    }
}

# Hand the scripted part of the session to bash.
#
# configuration.nix gives root fish, and fish is a poor thing to type into
# programmatically. It repaints the line as characters arrive (syntax
# highlighting, autosuggestions) and it installs a command-not-found handler,
# so a command typed over a slow emulated serial line can be redrawn into
# something else -- observed as `echo PROBE:...` arriving as `eecho PROBE:...`,
# which fish then reported as an unknown command. The probe never ran, and the
# scraper picked a redraw fragment out of the transcript instead of a value, so
# every probe in this phase came back empty while the boot itself passed.
#
# Landing in fish first still proves the login shell works, which is the part
# worth testing. From here on the shell is bash with a fixed one-line prompt:
# no repainting, no autosuggestion, no command-not-found, no $? vs $status.
proc enter_bash {} {
    global spawn_id
    for {set i 0} {$i < 20} {incr i} {
        # Start bash with the prompt already set, in one command.
        #
        # This used to be two steps: `exec bash`, wait for RDY-4b91>, then set
        # PS1. But after exec the prompt is bash's own default, so waiting for
        # RDY-4b91> could never match and every attempt burned the full 30s
        # timeout before the PS1 line was even sent -- once per phase, in three
        # phases, in both modes. Passing PS1 through the environment means the
        # first prompt bash draws is already the one being waited for.
        if {[catch {send -s "exec env PS1='RDY-4b91> ' bash --noprofile --norc"}]} {
            reconnect_or_bail; continue
        }
        sleep 1
        if {[catch {send "\r"}]} { reconnect_or_bail; continue }
        set timeout 30
        expect {
            -re {RDY-4b91>} { }
            eof     { reconnect_or_bail; continue }
            timeout { continue }
        }
        # bash's own default prompt is not the marker we want to key on, so set
        # it explicitly once we are in.
        # Bracketed paste wraps typed input in escape sequences and readline
        # echoes them back, which is noise at best and, over a slow serial
        # line, another chance for a command to be redrawn into something
        # else. Turn it off along with any line editing.
        # Now inside bash: quieten readline. Bracketed paste wraps typed input
        # in escape sequences and echoes them back, which is noise at best and
        # another chance for a command to be redrawn at worst.
        send -s "bind 'set enable-bracketed-paste off' 2>/dev/null; set +o emacs 2>/dev/null"
        sleep 1
        if {[catch {send "\r"}]} { reconnect_or_bail; continue }
        expect {
            -re {RDY-4b91>} { return 1 }
            eof     { reconnect_or_bail }
            timeout { }
        }
    }
    return 0
}

# Prove the shell is actually reading, not just that a prompt marker appeared.
#
# Matching the first OSC 133 marker is not enough: the getty emits it before
# the shell is interactive, so a command typed at that point goes into
# something that is not yet reading it and is silently lost. That is what left
# the replace phase with its command sitting unexecuted on the prompt line
# while systemd carried on printing unit messages.
#
# So: echo a token and require it back. Short commands submit reliably even
# when longer ones do not, and getting the token proves the shell will run
# what we send next.
proc wait_shell_ready {} {
    global spawn_id nudges
    set tok "SHELL-READY-7f3a"
    for {set i 0} {$i < 60} {incr i} {
        # UTM drops the serial TCP client whenever the guest reinitialises the
        # UART, and that can land in the middle of this handshake. `send` on a
        # closed spawn id raises "spawn id expN not open", which killed the
        # whole phase with a Tcl stack trace instead of reconnecting. Treat a
        # failed send as a drop and get the connection back.
        if {[catch {send -s "echo $tok"}]} { reconnect_or_bail; continue }
        sleep 1
        if {[catch {send "\r"}]} { reconnect_or_bail; continue }
        set timeout 20
        expect {
            -re "$tok\[^\r\n\]*\r" { return 1 }
            eof     { reconnect_or_bail }
            timeout { }
        }
    }
    return 0
}

serial_connect

# ---------------------------------------------------------------- reach a shell
#
# The prompt to match is NOT the NixOS default. configuration.nix installs
# starship and drives fish with it, so the installed system prompts like
#
#     root in ~
#     >
#
# with a multi-byte glyph -- nothing like the ISO's plain `[root@nixos:~]#`.
# What is stable and ASCII-safe is the OSC 133 prompt-start marker the shell
# emits (ESC ] 133 ; A), so that is what these patterns key on, with the plain
# bash prompt kept as an alternative for the installer environment.

set timeout $boot_timeout
send -s "\r"
expect {
    -re {\]133;A|root@[-a-z0-9]+:[^\r\n]*\]#} {
        if {![wait_shell_ready]} {
            bail 24 "a prompt appeared but the shell never echoed a token back"
        }
    }
    "Emergency Mode"    { bail 20 "guest dropped into emergency mode" }
    "Failed to import"  { bail 21 "root pool did not import" }
    "Entering emergency shell" { bail 20 "guest dropped into emergency shell" }
    -re {.+} {
        # Any console output at all means the guest is alive -- firmware still
        # searching, systemd still starting units. Reset the silence counter
        # and keep waiting. Without this the budget below was really a cap on
        # total boot time, so a slow-but-healthy boot got failed as a dead one.
        set nudges 0
        exp_continue
    }
    eof     { reconnect_or_bail; send -s "\r"; exp_continue }
    timeout {
        # Nudge the getty and keep waiting. One newline before the boot has
        # finished is not enough: the autologin session starts late (after
        # docker, timers, etc) and prints its prompt only when something asks
        # for it, so a single early \r is consumed by the boot spew.
        incr nudges
        # 120 cycles, not 40. A 20-minute budget was not enough: the replace
        # phase's guest boots but crawls, and exhausting the nudges made a slow
        # boot indistinguishable from a dead one. An hour is still bounded.
        if {$nudges > 120} { bail 22 "console silent for ~1h and no shell (did GRUB boot?)" }
        send -s "\r"
        exp_continue
    }
}

if {![enter_bash]} {
    bail 25 "reached a shell but could not hand the session to bash"
}

send -s "dmesg -n 1\r"
wait_prompt

set timeout $cmd_timeout

# ---------------------------------------------------------------- probes
#
# Each probe is a single line so a command that fails cannot swallow the ones
# after it. `|| echo ...` keeps a missing tool from hanging the expect loop.


# Emit one PROBE:<name>:<value> line per fact. tests/vm-boot.sh parses these
# out of the transcript, so this only has to send the command and wait for the
# prompt -- matching the echoed PROBE text itself proved unreliable here.
set probe_seq 0

proc probe {name cmd} {
    set timeout 300
    # { ...; } 2>&1 so the command's exit status cannot change what is
    # captured. Writing this as "$cmd 2>/dev/null | tr ..." with a caller
    # passing "cmd || true" parses as "cmd || { true | tr ... }": a command
    # that exits non-zero has its output thrown away and the empty true
    # branch captured instead. That silently blanked the zfs-health-check
    # probe, because a health check naturally exits non-zero when unhealthy.
    # Text first, then a separate Return once fish has stopped redrawing.
    # Guarded like the handshake: a serial drop mid-probe otherwise raises
    # "spawn id expN not open" and takes the whole phase down with a Tcl stack
    # trace, losing every probe that would have followed.
    # Wait for a per-probe end marker rather than for the prompt.
    #
    # Matching the prompt is not enough: it can match one printed before the
    # command's output has finished arriving, and the driver then sends the
    # next probe on top of the tail of this one. On a fast (KVM) guest that
    # produced interleaved lines like
    #     cPROBE:poolhealthy:pool 'zroot' isho PROBE:members_online:...
    # and the value was scored as empty. A slow emulated guest hid it.
    #
    # The marker is printed by a separate printf, so the literal text never
    # appears in the echoed command line -- matching the echo instead of the
    # output is exactly the false-positive this is meant to avoid.
    incr ::probe_seq
    set marker "EOP$::probe_seq"
    if {[catch {send -s "echo PROBE:$name:\$( { $cmd ; } 2>&1 | tr '\\n' '~' | tr -d '\\r' ) ; printf 'EOP%d\\n' $::probe_seq"}]} {
        reconnect_or_bail
        return
    }
    sleep 1
    if {[catch {send "\r"}]} { reconnect_or_bail; return }
    expect {
        -re "$marker" { }
        eof     { reconnect_or_bail }
        timeout { }
    }
}


probe hostname       "hostname"
probe systemstate    "systemctl is-system-running"
probe poolstate      "zpool list -H -o name,health | tr '\\t' ' ' | tr -s ' '"
probe poolhealthy    "zpool status -x zroot"
probe members_online "zpool status zroot | grep -c ONLINE"
probe degraded       "zpool status zroot | grep -c DEGRADED"
probe rootfs         "findmnt -n -o SOURCE /"
probe bootmounts     "findmnt -n -o TARGET,SOURCE | grep boot | tr -s ' '"
probe layout         "jq -c '{mode:.bootMode,n:(.bootDisks|length)}' /etc/nixos/disk-layout.json"
probe hostid         "hostid"
probe forceimport    "cat /proc/cmdline | tr ' ' '~'"

# systemctl is-system-running says "degraded" when any unit failed, but not
# which one. Naming them here is what makes that assertion actionable instead
# of a dead end.
probe failedunits    "systemctl --failed --no-legend --plain | tr -s ' '"

# The UEFI promise: GRUB is installed at the removable path on every ESP, so
# firmware finds it without an NVRAM entry pointing at a specific disk.
# Check every ESP, not just /boot. The invariant is that GRUB is installed at
# the removable path on each mirror member's ESP -- which one happens to be
# mounted at /boot is not the point, and hardcoding /boot made this assertion
# read an empty directory whenever that particular mount failed.
probe removable_efi  "ls /boot/EFI/BOOT/BOOTX64.EFI /boot-fallback-*/EFI/BOOT/BOOTX64.EFI"
probe health_check   "zfs-health-check"

# Diagnostic, not an assertion: which filenames actually differ between the
# first ESP and a fallback. zfs-health.nix compares the set of filenames on
# each boot mount and reported a freshly installed machine as carrying a stale
# bootloader copy; this says whether the installer really left a fallback
# incomplete or whether the check is counting a file it should ignore.
probe bootdiff "diff <(find /boot -type f -printf '%P\\n' | sort) <(find /boot-fallback-1 -type f -printf '%P\\n' | sort) | head -20"

send_log "\n\[step\] probes done\n"

send -s "poweroff\r"
expect {
    "Power down" { }
    eof          { }
    timeout      { }
}

exit 0
