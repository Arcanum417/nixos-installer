#!/usr/bin/env expect
#
# Boots the installed system and dumps a set of facts about it.
#
#   postboot.expect PORT LOGFILE
#
# Prints one "PROBE:<name>:<value>" line per fact and nothing else that the
# caller cares about; tests/vm-boot.sh parses those and does the asserting, so
# the assertions live in bash with the rest of the suite rather than in Tcl.
#
# Reaching a shell at all is the primary assertion: the guest autologins root
# on ttyS0 only if GRUB found a kernel, the initrd imported the root pool, and
# systemd got as far as a getty.

set port    [lindex $argv 0]
set logfile [lindex $argv 1]

log_file -a $logfile

set boot_timeout 1800
set cmd_timeout  300

proc bail {code msg} {
    send_user "\n\[postboot.expect\] FAILED: $msg\n"
    exit $code
}

# One disconnect per boot is expected: UTM drops the serial TCP client when the
# guest reinitialises the UART, which GRUB does on its way to the kernel.
set drops 0
set connected 0
proc serial_connect {} {
    global spawn_id port connected
    # Only close a connection that exists. `close` with nothing spawned
    # targets expect's own stdout and silently kills this script's output.
    if {$connected} { catch {close}; catch {wait} }
    sleep 2
    spawn nc 127.0.0.1 $port
    set connected 1
}
proc reconnect_or_bail {} {
    global drops
    incr drops
    if {$drops > 40} { bail 23 "serial connection kept dropping ($drops times)" }
    serial_connect
}

serial_connect

# ---------------------------------------------------------------- reach a shell

set timeout $boot_timeout
send "\r"
expect {
    -re {\[root@[-a-z0-9]+:.*\]#} { }
    -re {root@[-a-z0-9]+.*[#$] }  { }
    "Emergency Mode"    { bail 20 "guest dropped into emergency mode" }
    "Failed to import"  { bail 21 "root pool did not import" }
    "Entering emergency shell" { bail 20 "guest dropped into emergency shell" }
    eof     { reconnect_or_bail; send "\r"; exp_continue }
    timeout { bail 22 "no shell on the serial console after ${boot_timeout}s (did GRUB boot?)" }
}

send "dmesg -n 1\r"
expect -re {[#$] $}

set timeout $cmd_timeout

# ---------------------------------------------------------------- probes
#
# Each probe is a single line so a command that fails cannot swallow the ones
# after it. `|| echo ...` keeps a missing tool from hanging the expect loop.

proc probe {name cmd} {
    global cmd_timeout
    set timeout $cmd_timeout
    send "echo PROBE:$name:\$( $cmd 2>/dev/null | tr '\\n' '~' | tr -d '\\r' )\r"
    expect {
        -re "PROBE:$name:\[^\r\n\]*" { }
        timeout { send_user "\n\[postboot.expect\] probe $name timed out\n" }
    }
    expect -re {[#$] $}
}

probe hostname       "hostname"
probe systemstate    "systemctl is-system-running || true"
probe poolstate      "zpool list -H -o name,health"
probe poolhealthy    "zpool status -x zroot"
probe members_online "zpool status zroot | grep -c ONLINE"
probe degraded       "zpool status zroot | grep -c DEGRADED"
probe rootfs         "findmnt -n -o SOURCE /"
probe bootmounts     "findmnt -n -o TARGET,SOURCE | grep boot | tr -s ' '"
probe layout         "jq -c '{mode:.bootMode,n:(.bootDisks|length)}' /etc/nixos/disk-layout.json"
probe hostid         "hostid"
probe forceimport    "cat /proc/cmdline | tr ' ' '~'"

# The UEFI promise: GRUB is installed at the removable path on every ESP, so
# firmware finds it without an NVRAM entry pointing at a specific disk.
probe removable_efi  "ls /boot/EFI/BOOT/BOOTX64.EFI"
probe health_check   "zfs-health-check || true"

send "echo PROBES-DONE\r"
expect {
    "PROBES-DONE" { }
    timeout { }
}

send "poweroff\r"
expect {
    "Power down" { }
    eof          { }
    timeout      { }
}

exit 0
