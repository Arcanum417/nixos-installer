#!/usr/bin/env expect
#
# Boots the degraded machine, replaces the pulled disk with the blank one, and
# proves the pool comes back.
#
#   replace.expect PORT LOGFILE
#
# This runs /etc/nixos/replace-boot-disk.sh -- the copy the installer left on
# the machine, not the one in the repo, because that is what an operator would
# actually reach for. Emits the same PROBE: lines as postboot.expect once the
# resilver is done.

set port    [lindex $argv 0]
set logfile [lindex $argv 1]

log_file -a $logfile

set boot_timeout    1800
set cmd_timeout     300
set replace_timeout 7200

proc bail {code msg} {
    send_user "\n\[replace.expect\] FAILED: $msg\n"
    exit $code
}

# One disconnect per boot is expected: UTM drops the serial TCP client when the
# guest reinitialises the UART, which GRUB does on its way to the kernel.
set drops 0
set connected 0
proc serial_connect {} {
    global spawn_id port connected
    # Only close a connection that exists. `close` with nothing spawned
    # targets expect's own stdout and silently kills this script's output.
    if {$connected} { catch {close}; catch {wait} }
    sleep 2
    spawn nc 127.0.0.1 $port
    set connected 1
}
proc reconnect_or_bail {} {
    global drops
    incr drops
    if {$drops > 40} { bail 23 "serial connection kept dropping ($drops times)" }
    serial_connect
}

serial_connect

# ---------------------------------------------------------------- reach a shell

set timeout $boot_timeout
send "\r"
expect {
    -re {\[root@[-a-z0-9]+:.*\]#} { }
    -re {root@[-a-z0-9]+.*[#$] }  { }
    "Emergency Mode" { bail 20 "guest dropped into emergency mode" }
    eof     { reconnect_or_bail; send "\r"; exp_continue }
    timeout { bail 22 "no shell after ${boot_timeout}s" }
}
send "dmesg -n 1\r"
expect -re {[#$] $}

# ---------------------------------------------------------------- replace

send "/etc/nixos/replace-boot-disk.sh; echo REPLACE-EXIT=\$?\r"

set picked_new 0
set timeout $replace_timeout
expect {
    # ask PICK "which member to replace (number)" -- the default is already the
    # failed slot, so take it.
    "which member to" {
        send "\r"; exp_continue
    }

    # select_disks for the replacement. Only the new blank disk is offered:
    # the surviving members are excluded by by-id.
    "number toggles, d when done" {
        if {$picked_new == 0} { set picked_new 1; send "1\r" } else { send "d\r" }
        exp_continue
    }

    # confirm_hard "... REPLACE"
    "anything else aborts" {
        send "REPLACE\r"; exp_continue
    }

    # confirm "Delete its contents?" -- leftovers written to the root pool
    # while the disk was missing.
    "Y/n" {
        send "y"; exp_continue
    }

    "FATAL" { bail 13 "replace-boot-disk.sh aborted with a FATAL" }

    "REPLACE-EXIT=0" { send_user "\n\[replace.expect\] replace finished cleanly\n" }
    -re {REPLACE-EXIT=([1-9][0-9]*)} { bail 14 "replace-boot-disk.sh exited non-zero" }
    timeout { bail 15 "replace timed out after ${replace_timeout}s" }
}

# ---------------------------------------------------------------- resilver

# An 8 GiB mostly-empty mirror resilvers quickly, but wait for it rather than
# asserting against a pool that is still rebuilding.
set timeout $cmd_timeout
send "for i in \$(seq 1 120); do zpool status zroot | grep -q 'scan:.*resilvered' && break; sleep 5; done; echo RESILVER-WAITED\r"
set timeout 900
expect {
    "RESILVER-WAITED" { }
    timeout { send_user "\n\[replace.expect\] resilver wait timed out\n" }
}

# ---------------------------------------------------------------- probes

proc probe {name cmd} {
    set timeout 300
    send "echo PROBE:$name:\$( $cmd 2>/dev/null | tr '\\n' '~' | tr -d '\\r' )\r"
    expect {
        -re "PROBE:$name:\[^\r\n\]*" { }
        timeout { send_user "\n\[replace.expect\] probe $name timed out\n" }
    }
    expect -re {[#$] $}
}

probe poolhealthy "zpool status -x zroot"
probe poolstate   "zpool list -H -o name,health"
probe layout      "jq -c '{mode:.bootMode,n:(.bootDisks|length)}' /etc/nixos/disk-layout.json"
probe members     "zpool status zroot | grep -c ONLINE"

send "echo PROBES-DONE\r"
expect { "PROBES-DONE" { } timeout { } }

send "poweroff\r"
expect { "Power down" { } eof { } timeout { } }

exit 0
