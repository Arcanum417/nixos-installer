#!/usr/bin/env expect
#
# Boots the degraded machine, replaces the pulled disk with the blank one, and
# proves the pool comes back.
#
#   replace.expect LOGFILE PORT
#
# This runs /etc/nixos/replace-boot-disk.sh -- the copy the installer left on
# the machine, not the one in the repo, because that is what an operator would
# actually reach for. Emits the same PROBE: lines as postboot.expect once the
# resilver is done.

set logfile [lindex $argv 0]
set port    [lindex $argv 1]

# Written here rather than by redirecting stdout: expect buffers a redirected
# stdout, which hides progress during a long run and truncates the evidence if
# it is killed. log_file also captures send_user, so "FAILED:" reaches the log.
log_file -a $logfile

set boot_timeout    30
set cmd_timeout     300
set replace_timeout 7200

set send_slow {1 .03}

# A booting kernel produces far more output than expect's default 2000-byte
# match buffer holds. When it overflows expect discards the oldest half, and
# a marker that arrived in that half is never matched -- the transcript shows
# the text arriving while expect sits waiting for it.
match_max 200000

proc bail {code msg} {
    # send_log as well as send_user: log_file records only the spawned
    # process's I/O, so a send_user-only line never reaches the transcript
    # that the suite greps for "FAILED:".
    send_user "\n\[replace.expect\] FAILED: $msg\n"
    send_log  "\n\[replace.expect\] FAILED: $msg\n"
    exit $code
}

# One disconnect per boot is expected: UTM drops the serial TCP client when the
# guest reinitialises the UART, which GRUB does on its way to the kernel.
set drops 0
set nudges 0
set connected 0
proc serial_connect {} {
    global spawn_id port connected
    # Only close a connection that exists. `close` with nothing spawned
    # targets expect's own stdout and silently kills this script's output.
    if {$connected} { catch {close}; catch {wait} }
    sleep 2
    spawn nc 127.0.0.1 $port
    set connected 1
}
proc reconnect_or_bail {} {
    global drops
    incr drops
    if {$drops > 40} { bail 23 "serial connection kept dropping ($drops times)" }
    serial_connect
}

proc wait_prompt {} {
    global spawn_id
    expect {
        -re {\]133;A|root@[-a-z0-9]+:[^\r\n]*\]#} { }
        eof     { reconnect_or_bail; send -s "\r"; exp_continue }
        timeout { }
    }
}

serial_connect

# ---------------------------------------------------------------- reach a shell
#
# The prompt to match is NOT the NixOS default. configuration.nix installs
# starship and drives fish with it, so the installed system prompts like
#
#     root in ~
#     >
#
# with a multi-byte glyph -- nothing like the ISO's plain `[root@nixos:~]#`.
# What is stable and ASCII-safe is the OSC 133 prompt-start marker the shell
# emits (ESC ] 133 ; A), so that is what these patterns key on, with the plain
# bash prompt kept as an alternative for the installer environment.

set timeout $boot_timeout
send -s "\r"
expect {
    -re {\]133;A|root@[-a-z0-9]+:[^\r\n]*\]#} { }
    "Emergency Mode" { bail 20 "guest dropped into emergency mode" }
    eof     { reconnect_or_bail; send -s "\r"; exp_continue }
    timeout {
        # Nudge the getty and keep waiting. One newline before the boot has
        # finished is not enough: the autologin session starts late (after
        # docker, timers, etc) and prints its prompt only when something asks
        # for it, so a single early \r is consumed by the boot spew.
        incr nudges
        if {$nudges > 40} { bail 22 "no shell on the serial console (did GRUB boot?)" }
        send -s "\r"
        exp_continue
    }
}
send -s "dmesg -n 1\r"
wait_prompt

# ---------------------------------------------------------------- replace

# Answers on stdin, for the same reason as install.expect: confirm's "[Y/n]"
# cannot be matched on this console. Exact for "UEFI, slot 0 missing, one new
# blank disk offered":
#
#   <blank>  ask PICK -- the default is already the failed slot
#   1        select_disks: the only candidate is the new disk
#   d        select_disks done
#   REPLACE  confirm_hard
#   y        confirm "Delete its contents?" (leftovers written to the root
#            pool while the disk was missing; harmless if not asked)
send_log "\n\[step\] running replace-boot-disk.sh\n"
send -s "printf '\\n1\\nd\\nREPLACE\\ny\\n' | /etc/nixos/replace-boot-disk.sh; echo REPLACE-EXIT=\$?\r"

set timeout $replace_timeout
expect {
    -re {REPLACE-EXIT=0} { send_log "\n\[step\] replace finished cleanly\n" }
    -re {REPLACE-EXIT=[1-9]} { bail 14 "replace-boot-disk.sh exited non-zero" }
    -re {FATAL} { bail 13 "replace-boot-disk.sh aborted with a FATAL" }
    eof     { reconnect_or_bail; send -s "\r"; exp_continue }
    timeout { bail 15 "replace timed out after ${replace_timeout}s" }
}

# ---------------------------------------------------------------- resilver

# An 8 GiB mostly-empty mirror resilvers quickly, but wait for it rather than
# asserting against a pool that is still rebuilding.
set timeout $cmd_timeout
send -s "for i in \$(seq 1 120); do zpool status zroot | grep -q 'scan:.*resilvered' && break; sleep 5; done\r"
set timeout 900
wait_prompt
send_log "\n\[step\] resilver settled\n"

# ---------------------------------------------------------------- probes


# Emit one PROBE:<name>:<value> line per fact. tests/vm-boot.sh parses these
# out of the transcript, so this only has to send the command and wait for the
# prompt -- matching the echoed PROBE text itself proved unreliable here.
proc probe {name cmd} {
    set timeout 300
    send -s "echo PROBE:$name:\$( $cmd 2>/dev/null | tr '\\n' '~' | tr -d '\\r' )\r"
    wait_prompt
}


probe poolhealthy "zpool status -x zroot"
probe poolstate   "zpool list -H -o name,health"
probe layout      "jq -c '{mode:.bootMode,n:(.bootDisks|length)}' /etc/nixos/disk-layout.json"
probe members     "zpool status zroot | grep -c ONLINE"

send_log "\n\[step\] probes done\n"

send -s "poweroff\r"
expect { "Power down" { } eof { } timeout { } }

exit 0
