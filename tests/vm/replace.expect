#!/usr/bin/env expect
#
# Boots the degraded machine, replaces the pulled disk with the blank one, and
# proves the pool comes back.
#
#   replace.expect LOGFILE PORT
#
# This runs /etc/nixos/replace-boot-disk.sh -- the copy the installer left on
# the machine, not the one in the repo, because that is what an operator would
# actually reach for. Emits the same PROBE: lines as postboot.expect once the
# resilver is done.

set logfile [lindex $argv 0]
set port    [lindex $argv 1]

# Written here rather than by redirecting stdout: expect buffers a redirected
# stdout, which hides progress during a long run and truncates the evidence if
# it is killed. log_file also captures send_user, so "FAILED:" reaches the log.
log_file -a $logfile

set boot_timeout    1800
set cmd_timeout     300
set replace_timeout 7200

set send_slow {1 .03}

# A booting kernel produces far more output than expect's default 2000-byte
# match buffer holds. When it overflows expect discards the oldest half, and
# a marker that arrived in that half is never matched -- the transcript shows
# the text arriving while expect sits waiting for it.
match_max 200000

proc bail {code msg} {
    # send_log as well as send_user: log_file records only the spawned
    # process's I/O, so a send_user-only line never reaches the transcript
    # that the suite greps for "FAILED:".
    send_user "\n\[replace.expect\] FAILED: $msg\n"
    send_log  "\n\[replace.expect\] FAILED: $msg\n"
    exit $code
}

# One disconnect per boot is expected: UTM drops the serial TCP client when the
# guest reinitialises the UART, which GRUB does on its way to the kernel.
set drops 0
set connected 0
proc serial_connect {} {
    global spawn_id port connected
    # Only close a connection that exists. `close` with nothing spawned
    # targets expect's own stdout and silently kills this script's output.
    if {$connected} { catch {close}; catch {wait} }
    sleep 2
    spawn nc 127.0.0.1 $port
    set connected 1
}
proc reconnect_or_bail {} {
    global drops
    incr drops
    if {$drops > 40} { bail 23 "serial connection kept dropping ($drops times)" }
    serial_connect
}

serial_connect

# ---------------------------------------------------------------- reach a shell

set timeout $boot_timeout
send -s "\r"
expect {
    -re {root@[-a-z0-9]+:[^\r\n]*\]#} { }
    -re {root@[-a-z0-9]+:[^\r\n]*\]\$} { }
    "Emergency Mode" { bail 20 "guest dropped into emergency mode" }
    eof     { reconnect_or_bail; send -s "\r"; exp_continue }
    timeout { bail 22 "no shell after ${boot_timeout}s" }
}
send -s "dmesg -n 1; echo QUIET-OK\r"
expect { "QUIET-OK" { } timeout { } }

# ---------------------------------------------------------------- replace

send -s "/etc/nixos/replace-boot-disk.sh; echo REPLACE-EXIT=\$?\r"

set picked_new 0
set timeout $replace_timeout
# NOTE: no comments inside this expect block -- Tcl would treat each "#" line
# as a live pattern. The branches are:
#
#   "which member to"       ask PICK; the default is already the failed slot
#   "number toggles..."     select_disks for the replacement. Only the new
#                           blank disk is offered; surviving members are
#                           excluded by by-id
#   "anything else aborts"  confirm_hard "... REPLACE"
#   "Y/n"                   confirm "Delete its contents?" -- leftovers
#                           written to the root pool while the disk was missing
expect {
    "which member to" {
        send -s "\r"; exp_continue
    }
    "number toggles, d when done" {
        if {$picked_new == 0} { set picked_new 1; send -s "1\r" } else { send -s "d\r" }
        exp_continue
    }
    "anything else aborts" {
        send -s "REPLACE\r"; exp_continue
    }
    "Y/n" {
        send -s "y"; exp_continue
    }
    "FATAL" { bail 13 "replace-boot-disk.sh aborted with a FATAL" }
    "REPLACE-EXIT=0" { send_log "\n\[step\] replace finished cleanly\n" }
    -re {REPLACE-EXIT=([1-9][0-9]*)} { bail 14 "replace-boot-disk.sh exited non-zero" }
    eof     { reconnect_or_bail; send -s "\r"; exp_continue }
    timeout { bail 15 "replace timed out after ${replace_timeout}s" }
}

# ---------------------------------------------------------------- resilver

# An 8 GiB mostly-empty mirror resilvers quickly, but wait for it rather than
# asserting against a pool that is still rebuilding.
set timeout $cmd_timeout
send -s "for i in \$(seq 1 120); do zpool status zroot | grep -q 'scan:.*resilvered' && break; sleep 5; done; echo RESILVER-WAITED\r"
set timeout 900
expect {
    "RESILVER-WAITED" { }
    timeout { send_user "\n\[replace.expect\] resilver wait timed out\n" }
}

# ---------------------------------------------------------------- probes

proc probe {name cmd} {
    set timeout 300
    send -s "echo PROBE:$name:\$( $cmd 2>/dev/null | tr '\\n' '~' | tr -d '\\r' )\r"
    expect {
        -re "PROBE:$name:\[^\r\n\]*" { }
        timeout { send_user "\n\[replace.expect\] probe $name timed out\n" }
    }
}

probe poolhealthy "zpool status -x zroot"
probe poolstate   "zpool list -H -o name,health"
probe layout      "jq -c '{mode:.bootMode,n:(.bootDisks|length)}' /etc/nixos/disk-layout.json"
probe members     "zpool status zroot | grep -c ONLINE"

send -s "echo PROBES-DONE\r"
expect { "PROBES-DONE" { } timeout { } }

send -s "poweroff\r"
expect { "Power down" { } eof { } timeout { } }

exit 0
